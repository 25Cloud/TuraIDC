# Docker 构建上下文排除（作用于仓库根目录为上下文的构建：deploy/docker 下两个 Dockerfile）
# 目的：避免把密钥、依赖、构建产物和本地数据打入镜像

# 版本控制
.git
.gitignore
.gitattributes
.husky

# 依赖
**/node_modules
**/vendor

# 构建产物
**/dist
**/coverage

# 环境变量（保留 .env.example）
**/.env
**/.env.*
!.env.example
!**/.env.example
backend/.env.bak*

# 运行时数据（storage 以命名卷持久化，uploads/media 由 entrypoint 重建）
backend/storage
backend/public/uploads
backend/public/storage

# Laravel 包发现缓存：本地跑过带 dev 依赖的 composer install 后，
# bootstrap/cache/packages.php 会记入仅存在于 dev 的服务提供者（如 collision）。
# 镜像内是 composer install --no-dev，把这份缓存带进去会在启动时抛
# Class "NunoMaduro\Collision\...\CollisionServiceProvider" not found 并陷入重启循环。
# 该缓存由容器内的 package:discover 重新生成，无需从构建上下文携带。
# 只排除生成物，保留仓库跟踪的 .gitignore 占位文件以确保目录存在（否则 Laravel 会报
# "Please provide a valid cache path"）。
backend/bootstrap/cache/*.php

# 部署目录内的真实 .env（含密钥，禁止入镜像）
deploy/docker/.env

# 日志与临时文件
**/*.log
**/.DS_Store
**/.idea
**/.vscode
**/.tmp
