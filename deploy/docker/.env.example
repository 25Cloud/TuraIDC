# ============================================================================
# TuraIDC Docker Compose 环境变量模板
#
# 用法：
#   cd deploy/docker
#   cp .env.example .env
#   修改 .env 后：docker compose up -d --build（本地构建）
#   或配合 CI 推送的镜像：docker compose pull && docker compose up -d
#
# 【安全约定】.env 不入库（已在根 .dockerignore 排除），严禁提交真实密钥。
# 密码建议使用强随机值；避免使用双引号 " 和反斜杠 \ 字符，避免破坏 .env 解析。
# ============================================================================

# ---------------------------------------------------------------------------
# 镜像仓库（配合 CI 自动构建推送，见 .github/workflows/docker-image.yml）
# CI 推送 ${REGISTRY}/${IMAGE_NAMESPACE}/turaidc-{app,frontends}:{tag}
# 服务器拉取地址必须与此处一致。
# ---------------------------------------------------------------------------
REGISTRY=ghcr.io
IMAGE_NAMESPACE=25cloud
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# 四个公开地址（必填）
# 约束：互不相同、同一协议（全 http 或全 https）、无路径无账号信息。
# 浏览器直接访问这些地址；Docker 内部不负责 TLS，生产环境 HTTPS 由
# 1Panel / 宿主机 Nginx / Cloudflare 等反代终止（见部署指南"HTTPS 与反代"）。
# ---------------------------------------------------------------------------
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
CLIENT_CONSOLE_URL=https://console.example.com
ADMIN_URL=https://admin.example.com
# 官网/控制台跨子域共享登录态时填父域，例如 .example.com；单域部署留空
CLIENT_SESSION_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_NAME=图拉云
APP_ENV=production
APP_DEBUG=false
# APP_KEY 不要在此设置：Docker env_file 会把它注入容器环境变量，
# Laravel Dotenv 不覆盖已存在的环境变量，导致 entrypoint 生成的 key 被忽略。
# 容器启动时 entrypoint 会自动生成并写入 backend/.env。
# 首次初始化默认管理员密码（至少 12 位强密码，仅空库首次初始化时生效）
# ⚠️ 必须修改！直接使用示例值会导致管理员账号可被猜测。
#    entrypoint 会检测未修改的示例值并拒绝启动。
INSTALL_ADMIN_PASSWORD=PLEASE_CHANGE_THIS_TO_A_STRONG_PASSWORD
# HTTPS 环境下为 true，纯 HTTP 环境为 false
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# 数据库（同时用于 mysql 容器与 app 容器）
# 数据库来源：DB_HOST 留空 = 使用编排内 mysql 容器（推荐）；
# 填写远程地址 = 不拉取不启动本地 mysql，app 直连远程库
# （需提前建库、对服务器 IP 授权；远程端口非 3306 时用 DB_PORT 覆盖）
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_DATABASE=turaidc
DB_USERNAME=turaidc
# ⚠️ 必须修改！直接使用示例值会导致数据库可被入侵。
DB_PASSWORD=PLEASE_CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_ROOT_PASSWORD=PLEASE_CHANGE_THIS_TO_A_DIFFERENT_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Redis（公网不要放行 6379；内网部署可设密码增加安全性）
# Redis 来源：REDIS_HOST 留空 = 使用编排内 redis 容器；
# 填写远程地址 = 不拉取不启动本地 redis，app 直连远程（端口用 REDIS_PORT 覆盖）
# 设了密码后 Redis 容器自动启用 requirepass，后端自动读取此密码连接。
# 留空 = 无密码（仅容器内网可访问，安全）；远程模式必须与远程实例一致
# ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 客户端（phpredis 已编译进后端镜像，一般不用改）
REDIS_CLIENT=phpredis

# ---------------------------------------------------------------------------
# 邮件（SMTP 凭据由管理端"邮件插件"配置；此处仅框架级默认驱动）
# ---------------------------------------------------------------------------
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# 队列与调度（与现网宝塔口径一致，通常不需要改）
# ---------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=file
TURAIDC_BUSINESS_QUEUES=provision,referral,notification,coupon,default
TURAIDC_SCHEDULE_QUEUE=automation

# ---------------------------------------------------------------------------
# 对外端口（宿主机端口 -> 容器端口）
# frontends 容器内监听 8081(www) / 8082(console) / 8083(admin)
# 如果走 1Panel/宿主机 Nginx 反代，可改成只绑定 127.0.0.1，例如：
#   API_PORT=127.0.0.1:8080
# ---------------------------------------------------------------------------
API_PORT=8080
WWW_PORT=8081
CONSOLE_PORT=8082
ADMIN_PORT=8083

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------
# Sentry DSN，留空关闭
SENTRY_LARAVEL_DSN=
# 默认发件人（SMTP 凭据由管理端"邮件插件"配置）
MAIL_FROM_ADDRESS=hello@example.com
# 官网 SEO 动态渲染（默认即可工作；多域名部署时建议显式填官网域名）
# 官网公开地址，用于 canonical / sitemap / JSON-LD（默认取 APP_URL）
# SEO_SITE_URL=https://www.example.com
# 官网 index.html 模板（默认 http://frontends:8081/index.html，内部网络直连）
# SEO_FRONTEND_SHELL_URL=http://frontends:8081/index.html
# shell 模板 / 页面渲染结果缓存秒数（默认 600 / 300）
# SEO_SHELL_CACHE_TTL=600
# SEO_CACHE_TTL=300
