# 复制本文件为 .env 并按环境修改
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# 站点标题兜底值：站点配置接口失败/首帧未注入时使用，部署方应改成自己的品牌或留空
VITE_APP_TITLE=
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5175
# 控制台地址。与官网同域名部署时必须带子路径（控制台 router base），
# 否则 /client/login 会落进官网 SPA，登录和注册都点不进去；构建时会直接报错拦截。
VITE_CONSOLE_SITE_URL=http://127.0.0.1:5173/console
# 仅在 VITE_CONSOLE_SITE_URL 未配置、需要按「同域 + 子路径」推断时使用。
VITE_CONSOLE_BASE_PATH=/console
# 本地开发时 Cookie 作用域留空（不同端口无法共享域名 Cookie）
VITE_SESSION_COOKIE_DOMAIN=
