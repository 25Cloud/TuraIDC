{
  "name": "turaidc-frontends-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "author": "TuraIDC Contributors",
  "homepage": "https://github.com/25Cloud/TuraIDC",
  "repository": {
    "type": "git",
    "url": "https://github.com/25Cloud/TuraIDC.git"
  },
  "bugs": {
    "url": "https://github.com/25Cloud/TuraIDC/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "idc",
    "cloud",
    "finance",
    "billing",
    "laravel",
    "vue",
    "provisioning"
  ],
  "workspaces": [
    "frontend-admin-v3",
    "frontend-user-v3-www",
    "frontend-user-v4-console",
    "shared"
  ],
  "scripts": {
    "dev:admin-v3": "npm run dev --workspace chuangouyun-admin-v3",
    "dev:user-v3-www": "npm run dev --workspace chuangouyun-user-v3-www",
    "dev:user-v4-console": "npm run dev --workspace chuangouyun-user-v4-console",
    "build:admin-v3": "node backend/scripts/build_frontends.mjs --target=admin",
    "build:user-v3-www": "node backend/scripts/build_frontends.mjs --target=www",
    "build:user-v4-console": "node backend/scripts/build_frontends.mjs --target=console",
    "build:frontends": "node backend/scripts/build_frontends.mjs",
    "lint:shared": "npm run lint --workspace shared",
    "lint:admin-v3": "npm run lint --workspace chuangouyun-admin-v3",
    "lint:user-v3-www": "npm run lint --workspace chuangouyun-user-v3-www",
    "lint:user-v4-console": "npm run lint --workspace chuangouyun-user-v4-console",
    "lint:frontends": "npm run lint:shared && npm run lint:admin-v3 && npm run lint:user-v3-www && npm run lint:user-v4-console",
    "typecheck:shared": "npm run typecheck --workspace shared",
    "typecheck:admin-v3": "npm run build:type --workspace chuangouyun-admin-v3",
    "typecheck:user-v3-www": "npm run build:type --workspace chuangouyun-user-v3-www",
    "typecheck:user-v4-console": "npm run build:type --workspace chuangouyun-user-v4-console",
    "typecheck:frontends": "npm run typecheck:shared && npm run typecheck:admin-v3 && npm run typecheck:user-v3-www && npm run typecheck:user-v4-console",
    "format": "prettier --write \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "verify:frontends": "npm run lint:frontends && npm run typecheck:frontends && npm run build:frontends && npm run verify:refactor --workspace chuangouyun-user-v3-www && npm run verify:refactor --workspace chuangouyun-user-v4-console",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.25.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "sharp": "^0.35.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "tvision-color@1.6.0": {
      "@babel/runtime-corejs3": "7.29.7"
    }
  }
}
