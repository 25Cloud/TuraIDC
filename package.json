{
  "name": "turaidc-frontends-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "author": "TuraIDC Contributors",
  "homepage": "https://github.com/25Cloud/TuraIDC",
  "repository": {
    "type": "git",
    "url": "https://github.com/25Cloud/TuraIDC.git"
  },
  "bugs": {
    "url": "https://github.com/25Cloud/TuraIDC/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.13.1",
  "keywords": [
    "idc",
    "cloud",
    "finance",
    "billing",
    "laravel",
    "vue",
    "provisioning"
  ],
  "scripts": {
    "dev:admin-v3": "pnpm --filter chuangouyun-admin-v3 dev",
    "dev:user-v3-www": "pnpm --filter chuangouyun-user-v3-www dev",
    "dev:user-v4-console": "pnpm --filter chuangouyun-user-v4-console dev",
    "build:admin-v3": "node backend/scripts/build_frontends.mjs --target=admin",
    "build:user-v3-www": "node backend/scripts/build_frontends.mjs --target=www",
    "build:user-v4-console": "node backend/scripts/build_frontends.mjs --target=console",
    "build:frontends": "node backend/scripts/build_frontends.mjs",
    "lint:shared": "pnpm --filter shared lint",
    "lint:admin-v3": "pnpm --filter chuangouyun-admin-v3 lint",
    "lint:user-v3-www": "pnpm --filter chuangouyun-user-v3-www lint",
    "lint:user-v4-console": "pnpm --filter chuangouyun-user-v4-console lint",
    "lint:frontends": "pnpm lint:shared && pnpm lint:admin-v3 && pnpm lint:user-v3-www && pnpm lint:user-v4-console",
    "typecheck:shared": "pnpm --filter shared typecheck",
    "typecheck:admin-v3": "pnpm --filter chuangouyun-admin-v3 build:type",
    "typecheck:user-v3-www": "pnpm --filter chuangouyun-user-v3-www build:type",
    "typecheck:user-v4-console": "pnpm --filter chuangouyun-user-v4-console build:type",
    "typecheck:frontends": "pnpm typecheck:shared && pnpm typecheck:admin-v3 && pnpm typecheck:user-v3-www && pnpm typecheck:user-v4-console",
    "format": "prettier --write \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "verify:frontends": "pnpm lint:frontends && pnpm typecheck:frontends && pnpm build:frontends && pnpm --filter chuangouyun-user-v3-www verify:refactor && pnpm --filter chuangouyun-user-v4-console verify:refactor",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "Feat",
          "Fix",
          "Refactor",
          "Chore",
          "Docs",
          "Build",
          "Ci",
          "Style",
          "Perf",
          "Revert",
          "feat",
          "fix",
          "refactor",
          "chore",
          "docs",
          "build",
          "ci",
          "style",
          "perf",
          "revert"
        ]
      ],
      "type-case": [
        0
      ],
      "header-case": [
        0
      ]
    }
  },
  "lint-staged": {
    "frontend-*/src/**/*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "shared/src/**/*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.3",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "tvision-color@1.6.0": {
      "@babel/runtime-corejs3": "7.29.7"
    }
  }
}
