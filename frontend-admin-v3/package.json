{
  "name": "turaidc-admin-v3",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:linux": "vite --mode development",
    "dev:ci": "vite --host 127.0.0.1 --mode development",
    "build:test": "vite build --mode test",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "build:type": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "stylelint": "stylelint src/**/*.{html,vue,css,sass,less}",
    "stylelint:fix": "stylelint --fix src/**/*.{html,vue,css,sass,less}",
    "test": "pnpm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@turaidc/shared": "file:../shared",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.3",
    "tdesign-icons-vue-next": "^0.4.10",
    "tdesign-vue-next": "^1.20.6",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "~3.5.41",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.3.0",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "rspack-resolver": "^1.3.0",
    "stylelint": "~17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "~8.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.3.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.13.1"
}
