; 魔方财务 → 图拉云 迁移器配置文件
; 使用方法：把本文件复制为 mofang_migrate.conf 并填写真实值。
; mofang_migrate.conf 含密码，已加入 .gitignore，不会提交到仓库。
;
; 参数合并优先级：命令行参数 > 环境变量 MOFANG_MIGRATE_<KEY> > 本配置文件
; 对应环境变量（示例）：MOFANG_MIGRATE_HOST / MOFANG_MIGRATE_PORT /
;   MOFANG_MIGRATE_USER / MOFANG_MIGRATE_PASSWORD / MOFANG_MIGRATE_DATABASE / MOFANG_MIGRATE_DUMP
; 缺少 dump 时自动发现项目根/脚本目录下的 25y_*.sql；缺少 user/password 会报错退出。

[db]
; 目标库连接信息（图拉云 turaidc）
host = 127.0.0.1
port = 3306
user = turaidc
password =
database = turaidc

[source]
; 源 MySQL dump 文件路径（不填则自动发现项目根/脚本目录下的 25y_*.sql）
dump =
