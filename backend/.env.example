# 复制本文件为 .env 并按环境修改
APP_NAME="图拉云"
APP_ENV=local
APP_DEBUG=true
# 执行 php artisan key:generate 生成
APP_KEY=
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5175
CLIENT_CONSOLE_URL=http://127.0.0.1:5173
ADMIN_URL=http://127.0.0.1:5174

APP_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

# 数据库
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=root
DB_PASSWORD=

# 队列（生产建议使用 redis）
QUEUE_CONNECTION=database

# 缓存与 Redis
# 生产环境必须使用 redis（分布式锁依赖 Redis）
CACHE_STORE=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 会话
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 日志
LOG_CHANNEL=stack
LOG_LEVEL=debug

# 邮件（可选）
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="图拉云"

# ---- 以下为可选集成的占位配置，按需填写 ----
# 支付宝
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=

# 实名认证（IDC）
# VERIFICATION_KEY=
# VERIFICATION_API_ENDPOINT=

# 短信（阿里云）
# SMS_API_ENDPOINT=

# 极验
# GEETEST_ENABLED=false
# GEETEST_CAPTCHA_ID=
# GEETEST_CAPTCHA_KEY=

# VNC Relay
# VNC_RELAY_HOST=127.0.0.1
# VNC_RELAY_PORT=8100

# Sentry（可选）
# SENTRY_DSN=
