# ============================================================================
# 后端环境变量示例（backend/.env.example）
#
# 用法：cp .env.example .env && php artisan key:generate
#
# 本文件覆盖 backend/config/*.php 中所有 env() 引用的键。
# 【安全约定】此文件进入版本库，严禁写入任何真实密钥、密码、Token、证书私钥。
#            凡是敏感项一律留空或使用 your-xxx-here 占位符。
# ============================================================================

# ---------------------------------------------------------------------------
# 应用基础（config/app.php）
# ---------------------------------------------------------------------------
APP_NAME="图拉云"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
# 轮换旧密钥时使用，逗号分隔；敏感，留空
APP_PREVIOUS_KEYS=
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# 上游工单回调签名密钥（仅用于 ZJMF 上游回复回调，生产环境必须设置随机高强度值）
TICKET_UPSTREAM_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# 四个公开地址（config/app.php、config/cors.php、config/sanctum.php）
#
# 约束（backend/scripts/build_frontends.mjs 会强校验，不满足直接构建失败）：
#   1. 四个都必须是无路径、无账号信息的 HTTP(S) 根地址（如 https://a.example.com）
#   2. 四个 origin 必须互不相同
#   3. 四个必须使用同一协议（全 http 或全 https），避免浏览器混合内容
# 本地开发也可用端口区分，例如 http://127.0.0.1:8000 / :3000 / :3001 / :3002
# ---------------------------------------------------------------------------
APP_URL=https://tural.furll.cn
FRONTEND_URL=https://www.example.test
CLIENT_CONSOLE_URL=https://console.example.test
ADMIN_URL=https://admin.example.test

# ---------------------------------------------------------------------------
# 数据库（config/database.php）
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=idc
DB_USERNAME=idc
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+08:00
# MySQL 服务端 CA 证书路径，按需填写
MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# Redis（config/database.php）
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=10
REDIS_CACHE_DB=1
REDIS_VOLATILE_DB=2

# ---------------------------------------------------------------------------
# 缓存（config/cache.php）
# ---------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=
DB_CACHE_TABLE=cache
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
# 仅 CACHE_STORE=database 时使用，留空会解析成非法连接名
# DB_CACHE_CONNECTION=

# ---------------------------------------------------------------------------
# 队列（config/queue.php）
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
TURAIDC_BUSINESS_QUEUES=provision,referral,notification,coupon,default
TURAIDC_SCHEDULE_QUEUE=automation
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_BATCHES_TABLE=job_batches
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_FAILED_TABLE=failed_jobs
# 下面两项默认由代码推导，留空会覆盖默认值
# DB_QUEUE_CONNECTION=
# REDIS_QUEUE_BLOCK_FOR=

# ---------------------------------------------------------------------------
# 会话（config/session.php）
# 注意：下面注释掉的键默认值由代码推导，写成空值会覆盖掉推导结果，需要时再取消注释
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_TABLE=sessions
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# 默认按 APP_NAME 生成，如 tu_la_yun_session
# SESSION_COOKIE=
# 跨子域共享会话时填父域，如 .example.com
# SESSION_DOMAIN=
# 仅 SESSION_DRIVER=database 时使用
# SESSION_CONNECTION=
# 仅 SESSION_DRIVER=cache 时使用
# SESSION_STORE=

# 前端构建脚本 build_frontends.mjs 读取，注入 VITE_SESSION_COOKIE_DOMAIN
# 三个前端跨子域共享会话时填父域，例如 .example.com；单域部署留空
CLIENT_SESSION_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Sanctum（config/sanctum.php）
# ---------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_IDLE_TIMEOUT=10800
# Token 前缀属于凭据相关配置，留空
SANCTUM_TOKEN_PREFIX=
# 不设置时由上面四个地址的 host 自动推导；写成空值会导致有状态域名列表失效
# SANCTUM_STATEFUL_DOMAINS=

# ---------------------------------------------------------------------------
# 日志（config/logging.php）
# LOG_CHANNEL / LOG_STACK / LOG_LEVEL 未设置时按 APP_ENV 是否为 production 推导
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
# 仅 syslog 通道使用，不设置时默认 LOG_USER(8)；写成空值会传入非法 facility
# LOG_SYSLOG_FACILITY=8

# ---------------------------------------------------------------------------
# 文件系统（config/filesystems.php）
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# 邮件（config/mail.php）
# 注意：SMTP 凭据（host/port/username/password/from_name/encryption）已由
#       管理端"邮件插件"接管，此处仅保留框架级驱动与发件人默认值
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
# 下面两项默认由代码推导，留空会覆盖默认值
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=

# ---------------------------------------------------------------------------
# 集成默认实现（config/integrations.php）
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_DEFAULT=alipay
IDENTITY_PROVIDER_DEFAULT=stay33
SMS_PROVIDER_DEFAULT=aliyun
MAIL_DRIVER_DEFAULT=smtp
UPSTREAM_PROVIDER_DEFAULT=

# ---------------------------------------------------------------------------
# 站点与第三方能力（config/idc.php）
#
# 注意：站点名称、支付宝凭据、实名认证、极验、邮件 SMTP 的凭据与开关
#       均已由管理端"插件管理/系统设置"接管，不再使用环境变量配置。
#       所有 *_SSL_VERIFY 不设置时按 APP_ENV === production 推导
#      （生产强制校验证书、本地关闭），此处保持注释以免覆盖该逻辑
# ---------------------------------------------------------------------------

# 支付宝回调/网关等非凭据项（config/alipay.php）
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_CA_BUNDLE=
# 不设置时按 APP_ENV === production 推导（生产开启、其余关闭）
# ALIPAY_SSL_VERIFY=true

# 主机面板对接
HOSTING_PANEL_API_CA_BUNDLE=
HOSTING_PANEL_API_ALLOWED_HOSTS=
HOSTING_PANEL_API_JWT_CACHE_STORE=redis
HOSTING_PANEL_API_DNS_TIMEOUT=3
HOSTING_PANEL_API_CONNECT_TIMEOUT=15
# HOSTING_PANEL_API_SSL_VERIFY=true

# 短信（凭据类在管理端短信插件中设置；此处仅保留网络层配置）
SMS_API_ENDPOINT=https://dypnsapi.aliyuncs.com/
SMS_CA_BUNDLE=
# SMS_SSL_VERIFY=true

# VNC 中继
VNC_RELAY_HOST=127.0.0.1
VNC_RELAY_PORT=8100
VNC_RELAY_PATH=/ws/vnc
VNC_RELAY_CA_BUNDLE=
VNC_RELAY_CONNECT_TIMEOUT=10
# VNC_RELAY_SSL_VERIFY=true

# 前端产物目录，不设置时默认 backend/../frontend-client/dist
# 写成空值会得到空路径，需要时再取消注释并填绝对路径
# FRONTEND_DIST_PATH=

# ---------------------------------------------------------------------------
# 健康检查（config/health.php）
# ---------------------------------------------------------------------------
HEALTH_SCHEDULER_MAX_AGE_SECONDS=180
HEALTH_SCHEDULER_TASK_FAILURE_WINDOW_SECONDS=900
HEALTH_QUEUE_MAX_PENDING_JOBS=10000

# ---------------------------------------------------------------------------
# 历史数据迁移工具（config/*_migration.php）
# 值为 config/database.php 中的连接名
# ---------------------------------------------------------------------------
ACCOUNT_MIGRATION_SOURCE_DB=mysql
ACCOUNT_MIGRATION_TARGET_DB=mysql
CATALOG_MIGRATION_SOURCE_DB=mysql
CATALOG_MIGRATION_TARGET_DB=mysql
CONTENT_SYSTEM_MIGRATION_SOURCE_DB=mysql
CONTENT_SYSTEM_MIGRATION_TARGET_DB=mysql
IDENTITY_MIGRATION_SOURCE_DB=mysql
IDENTITY_MIGRATION_TARGET_DB=mysql
SERVICE_MIGRATION_SOURCE_DB=mysql
SERVICE_MIGRATION_TARGET_DB=mysql
SERVICE_MIGRATION_LEGACY_DB_DATABASE=
SERVICE_MIGRATION_LEGACY_TABLE_PREFIX=
TRADE_MIGRATION_SOURCE_DB=mysql
TRADE_MIGRATION_TARGET_DB=mysql

# ---------------------------------------------------------------------------
# Sentry（config/sentry.php）
# DSN 属于凭据，留空即关闭上报
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_LARAVEL_DSN=
SENTRY_SPOTLIGHT=false
SENTRY_STRICT_TRACE_CONTINUATION=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false

# 下列采样/标识项在 config/sentry.php 中用 === null 判断，
# 写成空值会被当作 0 或非法值（例如 sample_rate 变 0.0 即全部丢弃），必须保持注释状态
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_ORG_ID=
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_LOG_FLUSH_THRESHOLD=
# SENTRY_LOG_LEVEL=
# SENTRY_LOGS_LEVEL=

# Sentry 面包屑
SENTRY_BREADCRUMBS_LOGS_ENABLED=true
SENTRY_BREADCRUMBS_CACHE_ENABLED=true
SENTRY_BREADCRUMBS_LIVEWIRE_ENABLED=true
SENTRY_BREADCRUMBS_SQL_QUERIES_ENABLED=true
SENTRY_BREADCRUMBS_SQL_BINDINGS_ENABLED=false
SENTRY_BREADCRUMBS_QUEUE_INFO_ENABLED=true
SENTRY_BREADCRUMBS_COMMAND_JOBS_ENABLED=true
SENTRY_BREADCRUMBS_HTTP_CLIENT_REQUESTS_ENABLED=true
SENTRY_BREADCRUMBS_NOTIFICATIONS_ENABLED=true

# Sentry 链路追踪
SENTRY_TRACE_QUEUE_ENABLED=true
SENTRY_TRACE_QUEUE_JOBS_ENABLED=true
SENTRY_TRACE_SQL_QUERIES_ENABLED=true
SENTRY_TRACE_SQL_BINDINGS_ENABLED=false
SENTRY_TRACE_SQL_ORIGIN_ENABLED=true
SENTRY_TRACE_SQL_ORIGIN_THRESHOLD_MS=100
SENTRY_TRACE_VIEWS_ENABLED=true
SENTRY_TRACE_LIVEWIRE_ENABLED=true
SENTRY_TRACE_HTTP_CLIENT_REQUESTS_ENABLED=true
SENTRY_TRACE_CACHE_ENABLED=true
SENTRY_TRACE_REDIS_COMMANDS=false
SENTRY_TRACE_REDIS_ORIGIN_ENABLED=true
SENTRY_TRACE_NOTIFICATIONS_ENABLED=true
SENTRY_TRACE_MISSING_ROUTES_ENABLED=false
SENTRY_TRACE_CONTINUE_AFTER_RESPONSE=true
SENTRY_TRACE_DEFAULT_INTEGRATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# 黑洞防护（config/blackhole.php）
# ---------------------------------------------------------------------------
BLACKHOLE_CA_BUNDLE=
# 不设置时按 APP_ENV === production 推导
# BLACKHOLE_SSL_VERIFY=true
