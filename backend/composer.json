{
    "name": "idc/finance",
    "type": "project",
    "description": "二五云IDC财务系统 - Laravel 12",
    "keywords": [
        "idc",
        "cloud",
        "finance",
        "billing",
        "laravel"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/25Cloud/EwyFinance",
    "repository": {
        "type": "git",
        "url": "https://github.com/25Cloud/EwyFinance.git"
    },
    "support": {
        "issues": "https://github.com/25Cloud/EwyFinance/issues",
        "source": "https://github.com/25Cloud/EwyFinance"
    },
    "authors": [
        {
            "name": "EwyFinance Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "sentry/sentry-laravel": "^4.26"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "format": [
            "@php vendor/bin/pint"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
