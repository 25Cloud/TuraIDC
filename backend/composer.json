{
    "name": "idc/finance",
    "type": "project",
    "description": "图拉云业务/财务系统 - 新一代的IDC云服务经营系统 (Laravel 12)",
    "keywords": [
        "idc",
        "cloud",
        "finance",
        "billing",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/25Cloud/TuraIDC",
    "repository": {
        "type": "git",
        "url": "https://github.com/25Cloud/TuraIDC.git"
    },
    "support": {
        "issues": "https://github.com/25Cloud/TuraIDC/issues",
        "source": "https://github.com/25Cloud/TuraIDC"
    },
    "authors": [
        {
            "name": "TuraIDC Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "sentry/sentry-laravel": "^4.26"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan test"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 900
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/composer/"
        }
    }
}
